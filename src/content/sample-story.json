{
  "startSectionId": 1,
  "sections": {
    "1": {
      "id": 1,
      "title": "Escape",
      "text": [
        "The monastery burns.",
        "You hear screams in the distance."
      ],
      "effects": [
        { "type": "damage", "amount": 2 },
        { "type": "add_item", "item": "torch" },
        { "type": "add_gold", "amount": 3 }
      ],
      "choices": [
        {
          "id": "forest",
          "text": "Run to the forest",
          "target": 15
        },
        {
          "id": "storage",
          "text": "Enter the storage room",
          "target": 27,
          "requirements": [{ "type": "skill", "value": "Sixth Sense" }]
        }
      ]
    },
    "15": {
      "id": 15,
      "title": "Forest Edge",
      "text": [
        "Smoke follows you through the trees.",
        "A Giak blocks the path."
      ],
      "events": [
        {
          "type": "combat",
          "enemy": {
            "name": "Giak",
            "combatSkill": 15,
            "endurance": 12
          },
          "victoryTarget": 88,
          "defeatTarget": 350,
          "rewardEffects": [
            { "type": "add_gold", "amount": 2 },
            { "type": "set_flag", "key": "cleared-giak", "value": true }
          ]
        }
      ],
      "choices": [
        {
          "id": "advance",
          "text": "Advance cautiously",
          "target": 88
        },
        {
          "id": "fallback",
          "text": "Fall back to the road",
          "target": 1
        }
      ]
    },
    "27": {
      "id": 27,
      "title": "Storage Room",
      "text": [
        "You slip into the dark storage room.",
        "A bundle of supplies rests under a sheet."
      ],
      "effects": [
        { "type": "add_item", "item": "meal" },
        { "type": "heal", "amount": 1 }
      ],
      "choices": [
        {
          "id": "return",
          "text": "Return to the hall",
          "target": 15
        }
      ]
    },
    "88": {
      "id": 88,
      "title": "Outside Walls",
      "text": [
        "The trees open into cold air.",
        "For now, you are free."
      ],
      "choices": [
        {
          "id": "restart",
          "text": "Start over",
          "target": 1
        }
      ]
    },
    "350": {
      "id": 350,
      "title": "Defeat",
      "text": [
        "You fall to the ground as the world fades.",
        "The story ends here for now."
      ],
      "choices": [
        {
          "id": "retry",
          "text": "Try again",
          "target": 1
        }
      ]
    }
  }
}